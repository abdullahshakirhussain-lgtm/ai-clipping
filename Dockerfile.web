# ── Web image: Next.js dashboard ─────────────────────────────────────────────
# Build context = repo root (needs the whole workspace to resolve @clipfactory/*).
FROM node:22-bookworm-slim

# python3 is needed because the workspace install builds youtube-dl-exec
# (pulled in transitively via @clipfactory/core -> @clipfactory/media).
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates python3 python-is-python3 \
  && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

# NEXT_PUBLIC_API_URL is baked into the client bundle at build time, so the API's
# public URL must be provided as a build arg. Set it in Railway service settings.
ARG API_URL=http://localhost:3001
ENV API_URL=$API_URL
RUN pnpm --filter @clipfactory/web build

ENV NODE_ENV=production
EXPOSE 3000

# `next start` honors $PORT (Railway injects it).
CMD ["pnpm", "--filter", "@clipfactory/web", "start"]
