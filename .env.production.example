# ─────────────────────────────────────────────────────────────────────────────
# Production env for Railway — SIMPLE single-service topology
# (Postgres + API with in-process pipeline + web), with live AI + R2 storage.
#
# Set these as service variables in the Railway dashboard (do NOT commit real
# values). Vars marked [api] go on the API service, [web] on the web service.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# [api] Railway Postgres plugin exposes DATABASE_URL — reference it, don't hardcode.
# In the dashboard set:  DATABASE_URL = ${{ Postgres.DATABASE_URL }}
DATABASE_URL=

# [api] In-process pipeline — no Redis needed for the simple topology.
QUEUE_DRIVER=inprocess
REDIS_URL=

# [api] Cloudflare R2 (shared clip storage; presigned URLs served to the browser)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipfactory
# Optional: public/CDN base URL for the bucket. Leave blank to use presigned URLs.
R2_PUBLIC_BASE_URL=

# [api] Live AI — Groq Whisper + Anthropic Claude
AI_DRIVER=live
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# [api] Real downloads (required for live transcription to be meaningful)
DOWNLOAD_DRIVER=ytdlp

# [api] Publishing stays mock until you have approved TikTok/Meta/YouTube apps
PUBLISH_DRIVER=mock

# [api] Auth — generate a long random secret:  openssl rand -hex 32
BETTER_AUTH_SECRET=

# [api] Public URLs (fill in after Railway assigns domains). Must be the https
# domains, no trailing slash. WEB_URL drives CORS + Better Auth trusted origins.
API_URL=https://your-api.up.railway.app
WEB_URL=https://your-web.up.railway.app

# [api] First-run admin (created once on an empty DB — change the password!)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-something-strong

# [web] Baked into the client bundle at BUILD time (Railway build arg / variable).
# Must equal the API service's public URL.
API_URL=https://your-api.up.railway.app
