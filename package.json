{
  "name": "ai-clipping-factory",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @clipfactory/api dev\" \"pnpm --filter @clipfactory/web dev\"",
    "dev:worker": "pnpm --filter @clipfactory/worker dev",
    "dev:db": "tsx scripts/dev-db.ts",
    "db:generate": "pnpm --filter @clipfactory/db generate",
    "db:migrate": "pnpm --filter @clipfactory/db migrate",
    "db:seed": "pnpm --filter @clipfactory/db seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.20.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
