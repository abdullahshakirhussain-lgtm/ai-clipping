# ── Database ─────────────────────────────────────────────────────────────────
# Docker (docker compose up -d):  postgresql://postgres:postgres@localhost:5432/clipfactory
# Embedded dev DB (pnpm dev:db):  postgresql://postgres:postgres@localhost:5433/clipfactory
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/clipfactory

# ── Queue ────────────────────────────────────────────────────────────────────
# QUEUE_DRIVER: "bullmq" (production, needs REDIS_URL) | "inprocess" (dev, no Redis)
QUEUE_DRIVER=inprocess
REDIS_URL=

# ── Object storage ───────────────────────────────────────────────────────────
# STORAGE_DRIVER: "r2" (production) | "local" (dev, files under .data/storage)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipfactory
# Optional public/CDN base URL for the bucket; presigned URLs are used when empty
R2_PUBLIC_BASE_URL=

# ── AI providers ─────────────────────────────────────────────────────────────
# AI_DRIVER: "live" (real transcription + Anthropic Claude) | "mock" (no keys)
AI_DRIVER=mock
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Commentary is written by a two-pass (brainstorm -> select) on this model.
# Opus is wittier/less literal than Sonnet; text-only, still fractions of a cent.
COMMENTARY_MODEL=claude-opus-4-8
# Read on-screen text from up to 12 sampled frames to learn who/what a video is
# about (batched vision, early stop, <=~3 cents/video). Needs AI_DRIVER=live.
VISION_CONTEXT=true

# ── Commentary voice (TTS) ───────────────────────────────────────────────────
# TTS_PROVIDER: "mock" (silent, no keys) | "openai" (cheap, steerable pacing)
#             | "elevenlabs" (eleven_v3 — real pitch/emotion via inline audio
#               tags like "[shouts]"; Starter $6/mo covers ~150 clips)
TTS_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# ── Story Studio (generated videos) ──────────────────────────────────────────
# Image generation for AI narrated slideshows.
#   openai = gpt-image-1-mini (RECOMMENDED) — an instruction-following model that
#            actually draws simple stick figures + colorful scenes; ~$0.006/img
#            at low quality (~$0.09 / 15-beat video). Uses OPENAI_API_KEY above;
#            gpt-image models need org verification on some accounts.
#   fal    = FLUX.1 schnell (~$0.003/img, needs FAL_KEY) — cheapest, but a pure
#            diffusion model that will NOT render true stick figures.
#   mock   = solid cards, so the whole pipeline runs with no image key.
IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# low (~$0.09/video) | medium (~$0.22, sharper) | high | auto (both pricier)
OPENAI_IMAGE_QUALITY=low
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
STORY_MAX_BEATS=18
# Long-form slideshows need a new picture roughly every 3s to carry emotion.
# Beats stay natural sentences; any beat whose narration runs longer is split
# into extra stills of the same moment, capped by STORY_MAX_IMAGES (~$0.006 each).
STORY_IMAGE_SECONDS=3
STORY_MAX_IMAGES=30

# ── Cook Studio (generated cook-in-the-wild videos) ──────────────────────────
# Real video clips with NATIVE audio, hard-cut together (no narration), via
# Google Veo on the Gemini API DIRECTLY (no fal reseller markup). Veo 3.1 Fast
# @ 720p ≈ $0.10/sec (~$0.80 per 8s clip, ~$5 per 6-shot video).
# Just add GEMINI_API_KEY (from Google AI Studio) — the provider auto-selects
# Google when the key is present, and a stub mp4 when it isn't.
VIDEO_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_VEO_MODEL=veo-3.1-fast-generate-preview
VEO_RESOLUTION=720p
VEO_DURATION_SECONDS=8
# 9 x 8s = 72s, over the 60s TikTok Creator Rewards line.
COOK_MAX_SHOTS=9
# A photoreal still is drawn for each shot and handed to Veo as the clip's FIRST
# FRAME, so it animates an approved scene instead of imagining one. Each still is
# an edit of the previous one, which is what keeps the stone/fire/props identical
# across cuts. Same GEMINI_API_KEY; "off" reverts to plain text-to-video.
SCENE_IMAGE_PROVIDER=auto
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Animation Studio (fully animated stick shorts) ───────────────────────────
# One generated clip per narrated beat, so the figures actually move. Stick art
# asks far less of the model than photoreal cooking, so it runs on the cheap
# tier: Veo 3.1 Lite is $0.05/s (half of Fast) and still does image-to-video.
# 9 x 8s = 72s for ~$3.60. Switch to veo-3.1-fast-generate-preview if Lite
# disappoints. Veo has NO free tier — the key's project needs billing enabled.
GEMINI_ANIM_MODEL=veo-3.1-lite-generate-preview
ANIM_MAX_SHOTS=9

# ── Call Studio (fictional prank calls / talk-show rage bait) ────────────────
# Same Google key, no extra setup: a Gemini text model improvises the dialogue
# from the brief you approve, then a multi-speaker Gemini TTS model performs it
# as two voices. ~$10/M audio output tokens ≈ 3¢ for a 75-second call.
# Hit GET /api/v1/system/providers (or "Check API models" on the Create page)
# to confirm the key sees these models BEFORE spending anything on a render.
CALL_PROVIDER=auto
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TEXT_MODEL=gemini-2.5-flash
CALL_MAX_SECONDS=75

# ── Wave 3 (cloud, optional) ─────────────────────────────────────────────────
# Transcription: "groq" (Whisper, no speakers) | "deepgram" (word-level + diarization)
TRANSCRIBE_PROVIDER=groq
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# Reframing: "center" (static 9:16 crop) | "cloud" (face/active-speaker tracking; scaffold only)
REFRAME_PROVIDER=center
REFRAME_API_KEY=

# ── Media ────────────────────────────────────────────────────────────────────
# DOWNLOAD_DRIVER: "ytdlp" (real downloads) | "mock" (synthesizes a test video with FFmpeg)
# Primary ingest is now direct file upload; ytdlp remains available for URL ingest.
DOWNLOAD_DRIVER=mock

# ── Clip detection ───────────────────────────────────────────────────────────
# Clip count is driven by content + scoring, not a fixed number.
DETECT_MAX_CLIPS=30          # ceiling of clips kept per source video
DETECT_MIN_SCORE=55          # 0-100 overall-score floor; below this is discarded
DETECT_MIN_DURATION_SEC=12   # shortest clip
DETECT_MAX_DURATION_SEC=60   # longest clip
DETECT_CHUNK_MIN=12          # transcript window (minutes) per LLM detection call
DETECT_AUDIO_PEAKS=true      # also detect non-speech moments via audio energy

# ── Finder (source discovery) ────────────────────────────────────────────────
# Discovers videos accelerating on Reddit (later Twitch/Kick) and ranks them by
# velocity. Opt-in; needs a Reddit app (https://www.reddit.com/prefs/apps -> script).
DISCOVERY_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=clipfactory/1.0
DISCOVERY_SUBREDDITS=PublicFreakout,nextfuckinglevel,sports,funny,Damnthatsinteresting
DISCOVERY_POLL_MIN=15
DISCOVERY_MAX_AGE_H=24

# ── Publishing ───────────────────────────────────────────────────────────────
# PUBLISH_DRIVER: "live" (real platform APIs, requires approved developer apps) | "mock"
PUBLISH_DRIVER=mock

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_PORT=3001

# Dev bootstrap admin (created on API start if no users exist)
ADMIN_EMAIL=admin@clipfactory.local
ADMIN_PASSWORD=admin1234
