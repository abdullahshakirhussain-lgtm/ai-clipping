# ── Database ─────────────────────────────────────────────────────────────────
# Docker (docker compose up -d):  postgresql://postgres:postgres@localhost:5432/clipfactory
# Embedded dev DB (pnpm dev:db):  postgresql://postgres:postgres@localhost:5433/clipfactory
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/clipfactory

# ── Queue ────────────────────────────────────────────────────────────────────
# QUEUE_DRIVER: "bullmq" (production, needs REDIS_URL) | "inprocess" (dev, no Redis)
QUEUE_DRIVER=inprocess
REDIS_URL=

# ── Object storage ───────────────────────────────────────────────────────────
# STORAGE_DRIVER: "r2" (production) | "local" (dev, files under .data/storage)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipfactory
# Optional public/CDN base URL for the bucket; presigned URLs are used when empty
R2_PUBLIC_BASE_URL=

# ── AI providers ─────────────────────────────────────────────────────────────
# AI_DRIVER: "live" (real transcription + Anthropic Claude) | "mock" (no keys)
AI_DRIVER=mock
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Commentary is written by a two-pass (brainstorm -> select) on this model.
# Opus is wittier/less literal than Sonnet; text-only, still fractions of a cent.
COMMENTARY_MODEL=claude-opus-4-8
# Read on-screen text from up to 12 sampled frames to learn who/what a video is
# about (batched vision, early stop, <=~3 cents/video). Needs AI_DRIVER=live.
VISION_CONTEXT=true

# ── Commentary voice (TTS) ───────────────────────────────────────────────────
# TTS_PROVIDER: "mock" (silent, no keys) | "openai" (cheap, steerable pacing)
#             | "elevenlabs" (eleven_v3 — real pitch/emotion via inline audio
#               tags like "[shouts]"; Starter $6/mo covers ~150 clips)
TTS_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# ── Story Studio (generated videos) ──────────────────────────────────────────
# Image generation for AI narrated slideshows. "openai" = gpt-image-1 (uses the
# OPENAI_API_KEY above; needs org verification on some accounts). "mock" = solid
# cards, so the whole pipeline runs with no image key.
# fal = FLUX.1 schnell (~$0.003/img, needs FAL_KEY from fal.ai) | openai =
# gpt-image-1 (pricey) | mock = solid cards, no key.
IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-1
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
STORY_MAX_BEATS=15

# ── Wave 3 (cloud, optional) ─────────────────────────────────────────────────
# Transcription: "groq" (Whisper, no speakers) | "deepgram" (word-level + diarization)
TRANSCRIBE_PROVIDER=groq
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# Reframing: "center" (static 9:16 crop) | "cloud" (face/active-speaker tracking; scaffold only)
REFRAME_PROVIDER=center
REFRAME_API_KEY=

# ── Media ────────────────────────────────────────────────────────────────────
# DOWNLOAD_DRIVER: "ytdlp" (real downloads) | "mock" (synthesizes a test video with FFmpeg)
# Primary ingest is now direct file upload; ytdlp remains available for URL ingest.
DOWNLOAD_DRIVER=mock

# ── Clip detection ───────────────────────────────────────────────────────────
# Clip count is driven by content + scoring, not a fixed number.
DETECT_MAX_CLIPS=30          # ceiling of clips kept per source video
DETECT_MIN_SCORE=55          # 0-100 overall-score floor; below this is discarded
DETECT_MIN_DURATION_SEC=12   # shortest clip
DETECT_MAX_DURATION_SEC=60   # longest clip
DETECT_CHUNK_MIN=12          # transcript window (minutes) per LLM detection call
DETECT_AUDIO_PEAKS=true      # also detect non-speech moments via audio energy

# ── Finder (source discovery) ────────────────────────────────────────────────
# Discovers videos accelerating on Reddit (later Twitch/Kick) and ranks them by
# velocity. Opt-in; needs a Reddit app (https://www.reddit.com/prefs/apps -> script).
DISCOVERY_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=clipfactory/1.0
DISCOVERY_SUBREDDITS=PublicFreakout,nextfuckinglevel,sports,funny,Damnthatsinteresting
DISCOVERY_POLL_MIN=15
DISCOVERY_MAX_AGE_H=24

# ── Publishing ───────────────────────────────────────────────────────────────
# PUBLISH_DRIVER: "live" (real platform APIs, requires approved developer apps) | "mock"
PUBLISH_DRIVER=mock

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_PORT=3001

# Dev bootstrap admin (created on API start if no users exist)
ADMIN_EMAIL=admin@clipfactory.local
ADMIN_PASSWORD=admin1234
