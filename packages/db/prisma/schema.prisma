generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (Better Auth managed tables — field names must match Better Auth defaults)
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  REVIEWER
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(REVIEWER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  reviewActions ReviewAction[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// Domain
// ─────────────────────────────────────────────────────────────────────────────

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
}

enum SourcePlatform {
  YOUTUBE
  TWITCH
  KICK
  RUMBLE
  VIMEO
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum SourceVideoStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  TRANSCRIBING
  TRANSCRIBED
  DETECTING
  PROCESSED
  FAILED
}

enum ClipStatus {
  CANDIDATE
  RENDERING
  ENHANCING
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum ReviewActionType {
  APPROVE
  REJECT
  REGENERATE
  IMPROVE_HOOK
  IMPROVE_CAPTIONS
}

/// User-reported real-world result of a posted clip — feeds score calibration.
enum ClipOutcome {
  FLOP
  OK
  HIT
}

enum SocialAccountStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum PublishJobStatus {
  QUEUED
  SCHEDULED
  RUNNING
  PUBLISHED
  FAILED
  CANCELLED
}

/// A project/batch grouping for uploaded (or URL-ingested) source videos.
model Campaign {
  id               String         @id @default(cuid())
  name             String
  /// Optional default source URL for URL-based ingest; null for upload-only projects.
  sourceVideoUrl   String?
  sourcePlatform   SourcePlatform @default(YOUTUBE)
  allowedPlatforms Platform[]
  /// Free-form project rules (banned words, min/max clip length, etc.)
  rules            Json?
  expiresAt        DateTime?
  status           CampaignStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sourceVideos SourceVideo[]
  clips        Clip[]

  @@index([status])
}

model SourceVideo {
  id               String            @id @default(cuid())
  campaignId       String
  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  /// Set for URL/yt-dlp ingest; null when the file was uploaded directly.
  originalUrl      String?
  /// Original filename for uploaded sources.
  originalFilename String?
  status           SourceVideoStatus @default(PENDING)
  storageKey  String?
  title       String?
  durationSec Float?
  width       Int?
  height      Int?
  metadata    Json?
  error       String?
  /// Caption look + placement chosen at upload; inherited by this video's clips.
  captionStyle    String        @default("bold-center")
  captionPosition String        @default("bottom")
  /// Opt-in subject-aware reframing (face-tracking crop) for this video's clips.
  reframe         Boolean       @default(false)
  /// Opt-in auto sound-effects (whoosh/boom/faaaaa on absurd moments), kept sparse.
  autoEnhance     Boolean       @default(false)
  /// Repost mode: skip clip detection and treat the whole video as one output
  /// (captions/framing/SFX still apply). For adding subtitles to existing shorts.
  subtitlesOnly   Boolean       @default(false)
  /// Render as-is: skip jump-cuts/reframe/SFX, only burn captions. Inherited by clips.
  untouched       Boolean       @default(false)
  /// AI commentary voice-over: off | intro_outro | interject | full. Inherited by clips.
  commentaryMode  String        @default("off")
  /// User-typed context at upload ("Andrew Tate on the Fresh&Fit podcast") —
  /// authoritative; fed to commentary + enhancement prompts.
  context         String?
  /// Vision-derived context (on-screen text/watermarks read from sampled frames).
  /// Separate from `context` so regeneration never clobbers the user's text.
  autoContext     String?
  /// Content category chosen at upload; clips inherit it and route to matching accounts.
  category        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  transcript Transcript?
  clips      Clip[]

  @@index([campaignId])
  @@index([status])
}

model Transcript {
  id            String      @id @default(cuid())
  sourceVideoId String      @unique
  sourceVideo   SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  language      String      @default("en")
  fullText      String
  /// Array of { start, end, text, words?: [{ start, end, word }] }
  segments      Json
  provider      String      @default("mock")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Clip {
  id              String     @id @default(cuid())
  sourceVideoId   String
  sourceVideo     SourceVideo @relation(fields: [sourceVideoId], references: [id])
  campaignId      String
  campaign        Campaign   @relation(fields: [campaignId], references: [id])
  startSec        Float
  endSec          Float
  status          ClipStatus @default(CANDIDATE)
  storageKey      String?
  thumbnailKey    String?
  /// Why the detector picked this window
  detectionReason String?
  /// Which detector surfaced this window: "transcript" | "audio" | "hybrid"
  detectionSource String?
  captionStyle    String     @default("bold-center")
  captionPosition String     @default("bottom")
  /// Opt-in subject-aware reframing (face-tracking crop).
  reframe         Boolean    @default(false)
  /// Opt-in auto sound-effects.
  autoEnhance     Boolean    @default(false)
  /// Render as-is: skip jump-cuts/reframe/SFX, only burn captions (repost mode).
  untouched       Boolean    @default(false)
  /// AI commentary voice-over mode (inherited from the source video).
  commentaryMode  String     @default("off")
  /// Commentary voice tier: "standard" (cheap TTS) | "premium" (ElevenLabs v3).
  /// Manual per-clip upgrade only — premium spends paid credits.
  voiceTier       String     @default("standard")
  /// Edit-decision list applied at render (sfx cues; zoom/emoji later).
  edl             Json?
  /// Content category (inherited from the source video); routes distribution.
  category        String?
  /// Bulk-cull flag: false = discarded by the user in the grid.
  kept            Boolean    @default(true)
  /// Transparent scoring, computed at detection (see packages/core scoring.ts). 0-100.
  hookScore       Float      @default(0)
  viralScore      Float      @default(0)
  overallScore    Float      @default(0)
  /// Named sub-signal breakdown behind the scores (measured + LLM-judged).
  scoreBreakdown  Json?
  /// Real-world result once posted (user-labeled); null = not yet labeled.
  outcome         ClipOutcome?
  error           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  enhancement   ClipEnhancement?
  reviewActions ReviewAction[]
  publishJobs   PublishJob[]

  @@index([status])
  @@index([campaignId])
  @@index([sourceVideoId])
  @@index([overallScore])
  @@index([outcome])
  @@index([category])
}

model ClipEnhancement {
  id                  String   @id @default(cuid())
  clipId              String   @unique
  clip                Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  title               String
  description         String
  hashtags            String[]
  /// { variants: string[], selectedIndex: number }
  hooks               Json
  qualityScore        Float
  viralScore          Float
  estimatedEngagement Float
  model               String
  promptVersion       String   @default("v1")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ReviewAction {
  id         String           @id @default(cuid())
  clipId     String
  clip       Clip             @relation(fields: [clipId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?            @relation(fields: [reviewerId], references: [id])
  action     ReviewActionType
  note       String?
  createdAt  DateTime         @default(now())

  @@index([clipId])
  @@index([reviewerId])
}

model SocialAccount {
  id          String              @id @default(cuid())
  platform    Platform
  handle      String
  displayName String?
  /// Login username/email for this account (credential vault; not used to auto-post).
  username    String?
  /// AES-256-GCM encrypted login password (never returned in list DTOs).
  passwordEnc String?
  /// Content niche this account posts; clips route to accounts of the same category.
  category    String              @default("general")
  /// Optional target channel/page id the poster extension switches to before
  /// uploading (blank = post to whatever account is active in the browser).
  channelId   String?
  /// Posting cadence used to auto-schedule this account's queue.
  postsPerDay Int                 @default(10)
  activeStartHour Int             @default(9)
  activeEndHour   Int             @default(21)
  timezone    String              @default("UTC")
  /// Encrypted OAuth credentials / tokens for the platform (unused in manual flow)
  credentials Json?
  status      SocialAccountStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  publishJobs PublishJob[]

  @@unique([platform, handle])
  @@index([status])
  @@index([category])
}

/// Canonical list of content categories. The `name` is the exact string stored
/// on SocialAccount/SourceVideo/Clip.category (routing matches by string), so a
/// central rename must cascade those columns. This table is only the registry
/// of valid options the UI offers.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Commentary character for clips in this category ("condescending finance
  /// guy who's seen every scam"). Looked up by name at render time, so edits
  /// apply to the next render automatically. Null = default roast baseline.
  persona   String?
  createdAt DateTime @default(now())
}

model PublishJob {
  id              String           @id @default(cuid())
  clipId          String
  clip            Clip             @relation(fields: [clipId], references: [id])
  socialAccountId String
  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id])
  scheduledAt     DateTime?
  status          PublishJobStatus @default(QUEUED)
  attempts        Int              @default(0)
  maxAttempts     Int              @default(3)
  externalPostId  String?
  externalUrl     String?
  lastError       String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  publishAttempts PublishAttempt[]

  /// One post-task per clip+account (dedupe distribution).
  @@unique([clipId, socialAccountId])
  @@index([status])
  @@index([clipId])
  @@index([socialAccountId])
  @@index([scheduledAt])
}

model PublishAttempt {
  id           String     @id @default(cuid())
  publishJobId String
  publishJob   PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  success      Boolean    @default(false)
  /// Raw platform API response / error payload
  response     Json?

  @@index([publishJobId])
}

/// Singleton store for learned scoring weights (calibrated from clip outcomes).
model Calibration {
  id         String   @id @default("default")
  /// Learned weight overrides (same shape as detection.ts SCORING_WEIGHTS).
  weights    Json
  /// How many labeled clips the current weights were computed from.
  sampleSize Int      @default(0)
  /// Per-signal predictiveness + notes, for display.
  insights   Json?
  updatedAt  DateTime @updatedAt
}
